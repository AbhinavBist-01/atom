{
  "name": "atom-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ATOM: Autonomous GitHub Issue Resolution Agent",
  "scripts": {
    "dev": "pnpm --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:push": "pnpm --filter server db:push"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "prettier": "^3.4.2",
    "eslint": "^9.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
