{
  "name": "atom-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ATOM: Autonomous GitHub Issue Resolution Agent",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@atom/*\" dev",
    "dev:web": "pnpm --filter @atom/web dev",
    "dev:server": "pnpm build:packages && pnpm --filter @atom/server dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm --filter @atom/web build",
    "build:server": "pnpm --filter @atom/server build",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @atom/server db:generate",
    "db:migrate": "pnpm --filter @atom/server db:migrate",
    "db:push": "pnpm --filter @atom/server db:push",
    "db:studio": "pnpm --filter @atom/server db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
